<?xml version="1.0"?>
<sdf version="1.6">
  <world name="x500_world">
    <!-- sol + lumière -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- le drone X500 (le plugin ArduPilot est dans le modèle, port UDP 9002) -->
    <include>
      <uri>model://x500</uri>
      <name>x500</name>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
  </world>
</sdf>
