# Référence ArduPilot compilée dans l'image (branche ou tag).
# master est la référence suivie par ardupilot_gz : c'est la combinaison testée
# en amont. Un tag figé ancien (ex. Copter-4.5.7) n'est garanti ni compatible
# avec ardupilot_gz, ni compilable avec le GCC 13 d'Ubuntu 24.04.
# La version figée du cours, elle, est l'IMAGE publiée sur ghcr.io : elle porte
# le commit du dépôt en étiquette et ne change plus.
ARDUPILOT_VERSION=master

# Miroir apt ROS2 (dépôt qui fournit ros-jazzy-mavros).
# Laisser vide = dépôt officiel http://packages.ros.org/ros2/ubuntu
# Si ce dépôt est bloqué/stall (ex. RDC), utiliser un miroir. Plusieurs miroirs
# peuvent être listés (séparés par des espaces) : apt essaiera le suivant si le
# précédent échoue. Miroirs couvrant noble (ROS2 Jazzy) :
#   https://mirrors.aliyun.com/ros2/ubuntu        (fiable — testé ~1.7 Mo/s)
#   https://mirrors.huaweicloud.com/ros2/ubuntu
#   https://mirrors.cloud.tencent.com/ros2/ubuntu
ROS2_APT_MIRROR=https://mirrors.aliyun.com/ros2/ubuntu https://mirrors.huaweicloud.com/ros2/ubuntu

# Ecran pour la vue 3D (RViz/Gazebo). Sur Windows : laisser vide, lancer VcXsrv
# puis definir DISPLAY=127.0.0.1:0 avant scripts/start.bat.
DISPLAY=
